# Cross-condition stitched RNA velocity analysis

This notebook performs cross-condition RNA velocity analysis using scVelo and velocity-informed PAGA. Each condition is embedded independently by UMAP to preserve native cluster geometry. The embeddings are then stitched by translating one condition along the x-axis for visualization only. RNA velocity, neighborhood graph construction, and PAGA are computed in shared highly variable gene and PCA space across the concatenated dataset, not in stitched UMAP space.

# ============================================================
# Stitched cross-condition RNA velocity with scVelo + PAGA
# Generalized notebook version
# ============================================================

import os, gc
import numpy as np
import pandas as pd
import scanpy as sc
import scvelo as scv
import anndata as ad

scv.settings.verbosity = 3
scv.set_figure_params("scvelo", dpi=300, fontsize=12)

# ============================================================
# 1) USER SETTINGS
# ============================================================

OUTDIR = "results/stitched_velocity"
os.makedirs(OUTDIR, exist_ok=True)

# Processed h5ad files exported from Seurat
COND1_NAME = "CTRL"
COND2_NAME = "BMP7"

COND1_H5AD = "data/CTRL_combined.h5ad"
COND2_H5AD = "data/BMP7_combined.h5ad"

# velocyto loom files for each condition
COND1_LOOMS = [
    "data/CTRL_rep1.loom",
    "data/CTRL_rep2.loom"
]

COND2_LOOMS = [
    "data/BMP7_rep1.loom",
    "data/BMP7_rep2.loom"
]

CELLTYPE_COL = "Celltype_renamed"   # change if needed
CONDITION_COL = "condition"

N_TOP_GENES = 2000
N_PCS = 30
N_NEIGHBORS = 30
UMAP_GAP = 6.0

VELOCITY_MODE = "dynamical"  # "stochastic" or "dynamical"

# ============================================================
# 2) HELPER FUNCTIONS
# ============================================================

def loom_core_barcode(cellid: str) -> str:
    """Extract 10x barcode core from velocyto loom cell IDs."""
    s = str(cellid)
    if ":" in s:
        s = s.split(":")[-1]
    s = s.strip()
    if s.endswith("x"):
        s = s[:-1]
    return s


def fix_loom_genes(adata_loom: ad.AnnData) -> ad.AnnData:
    """Make loom gene names unique."""
    adata_loom = adata_loom.copy()
    adata_loom.var_names_make_unique()
    if not adata_loom.var_names.is_unique:
        adata_loom = adata_loom[:, ~adata_loom.var_names.duplicated()].copy()
    return adata_loom


def best_k_for_loom(raw_loom: ad.AnnData, h5ad_obs_names, ks=(1, 2, 3, 4)):
    """
    velocyto sometimes names cells as BARCODE-1_1, BARCODE-1_2, etc.
    This function finds the suffix giving best overlap with h5ad barcodes.
    """
    core = [loom_core_barcode(x) for x in raw_loom.obs_names.tolist()]
    hset = set(h5ad_obs_names.tolist())
    overlaps = {}

    for k in ks:
        candidate = {bc + f"-1_{k}" for bc in core}
        overlaps[k] = len(candidate & hset)

    best_k = max(overlaps, key=overlaps.get)
    return best_k, overlaps[best_k], overlaps


def rename_loom_to_match_h5ad(raw_loom: ad.AnnData, k: int) -> ad.AnnData:
    """Rename loom barcodes to match Seurat-exported h5ad barcodes."""
    loom = raw_loom.copy()
    loom.obs_names = [loom_core_barcode(x) + f"-1_{k}" for x in loom.obs_names.tolist()]
    loom.obs_names_make_unique()
    return loom


def build_loom_all(loom_paths, h5ad_obs_names, label):
    """Read, rename, clean, and concatenate multiple loom files."""
    raw_list = [scv.read(p, cache=True) for p in loom_paths]

    fixed = []
    for p, l in zip(loom_paths, raw_list):
        k, best_ov, all_ov = best_k_for_loom(l, h5ad_obs_names)
        print(f"[{label}] {os.path.basename(p)} -> best k={k} | overlap={best_ov} | all={all_ov}")

        l2 = rename_loom_to_match_h5ad(l, k)
        l2 = fix_loom_genes(l2)
        fixed.append(l2)

    if len(fixed) == 1:
        loom_all = fixed[0]
    else:
        loom_all = fixed[0].concatenate(
            fixed[1:],
            join="inner",
            batch_key="loom_batch",
            index_unique=None
        )

    print(f"{label} merged loom:", loom_all.shape)
    return loom_all


def slim_for_concat(adata_obj: ad.AnnData) -> ad.AnnData:
    """
    Keep only elements needed for velocity.
    This prevents memory-heavy concatenation problems.
    """
    keep_obs = adata_obj.obs.copy()
    keep_var = adata_obj.var.copy()

    layers_keep = {}
    for lyr in ["spliced", "unspliced", "ambiguous"]:
        if lyr in adata_obj.layers:
            layers_keep[lyr] = adata_obj.layers[lyr].copy()

    new = ad.AnnData(
        X=adata_obj.X.copy(),
        obs=keep_obs,
        var=keep_var,
        layers=layers_keep
    )

    for key in ["X_umap", "X_pca"]:
        if key in adata_obj.obsm:
            new.obsm[key] = adata_obj.obsm[key].copy()

    return new


def add_stitched_umap(adata_obj, condition_col, cond1, cond2, gap=6.0):
    """
    Stitch existing UMAPs by translating condition 2 along x-axis.
    This is for visualization only.
    """
    if "X_umap" not in adata_obj.obsm:
        raise ValueError("X_umap not found. Please compute or import UMAP first.")

    um = adata_obj.obsm["X_umap"].copy()

    mask2 = adata_obj.obs[condition_col].astype(str).values == cond2
    mask1 = adata_obj.obs[condition_col].astype(str).values == cond1

    if mask1.sum() == 0 or mask2.sum() == 0:
        raise ValueError("One condition has zero cells. Check condition labels.")

    shift = (um[mask1, 0].max() - um[mask2, 0].min()) + gap
    um[mask2, 0] += shift

    adata_obj.obsm["X_umap_stitched"] = um
    return adata_obj


# ============================================================
# 3) LOAD PROCESSED h5ad OBJECTS
# ============================================================

adata_1 = sc.read_h5ad(COND1_H5AD)
adata_2 = sc.read_h5ad(COND2_H5AD)

adata_1.obs[CONDITION_COL] = COND1_NAME
adata_2.obs[CONDITION_COL] = COND2_NAME

print(COND1_NAME, adata_1.shape, "UMAP:", "X_umap" in adata_1.obsm)
print(COND2_NAME, adata_2.shape, "UMAP:", "X_umap" in adata_2.obsm)

# ============================================================
# 4) LOAD AND MERGE VELOCYTO LOOM FILES
# ============================================================

loom_1 = build_loom_all(COND1_LOOMS, adata_1.obs_names.values, COND1_NAME)
loom_2 = build_loom_all(COND2_LOOMS, adata_2.obs_names.values, COND2_NAME)

print("Overlap", COND1_NAME, len(set(loom_1.obs_names) & set(adata_1.obs_names)), "/", adata_1.n_obs)
print("Overlap", COND2_NAME, len(set(loom_2.obs_names) & set(adata_2.obs_names)), "/", adata_2.n_obs)

# ============================================================
# 5) MERGE LOOM LAYERS WITH PROCESSED h5ad OBJECTS
# ============================================================

adata_1_v = scv.utils.merge(adata_1, loom_1)
adata_2_v = scv.utils.merge(adata_2, loom_2)

print(COND1_NAME, "layers:", list(adata_1_v.layers.keys()))
print(COND2_NAME, "layers:", list(adata_2_v.layers.keys()))

# ============================================================
# 6) FILTER, NORMALIZE, AND KEEP SHARED GENES
# ============================================================

scv.pp.filter_and_normalize(
    adata_1_v,
    min_shared_counts=20,
    n_top_genes=N_TOP_GENES
)

scv.pp.filter_and_normalize(
    adata_2_v,
    min_shared_counts=20,
    n_top_genes=N_TOP_GENES
)

shared_genes = adata_1_v.var_names.intersection(adata_2_v.var_names)
print("Shared genes after filtering:", len(shared_genes))

adata_1_v = adata_1_v[:, shared_genes].copy()
adata_2_v = adata_2_v[:, shared_genes].copy()

adata_1_v = slim_for_concat(adata_1_v)
adata_2_v = slim_for_concat(adata_2_v)

adata_1_v.obs[CONDITION_COL] = COND1_NAME
adata_2_v.obs[CONDITION_COL] = COND2_NAME

gc.collect()

# ============================================================
# 7) CONCATENATE CONDITIONS
# ============================================================

adata = ad.concat(
    [adata_1_v, adata_2_v],
    join="inner",
    merge="first",
    index_unique=None
)

print("Combined object:", adata.shape)

# ============================================================
# 8) CREATE STITCHED UMAP FOR VISUALIZATION ONLY
# ============================================================

adata = add_stitched_umap(
    adata,
    condition_col=CONDITION_COL,
    cond1=COND1_NAME,
    cond2=COND2_NAME,
    gap=UMAP_GAP
)

# Save stitched coordinates
pd.DataFrame(
    adata.obsm["X_umap_stitched"],
    index=adata.obs_names,
    columns=["UMAP_1_stitched", "UMAP_2_stitched"]
).to_csv(os.path.join(OUTDIR, "stitched_umap_coordinates.csv"))

# ============================================================
# 9) COMPUTE VELOCITY IN SHARED PCA SPACE
#    Not on stitched UMAP.
# ============================================================

sc.tl.pca(adata, n_comps=50, svd_solver="arpack")

n_pcs_avail = adata.obsm["X_pca"].shape[1]
n_pcs_use = min(N_PCS, n_pcs_avail)

print("PCA dimensions:", adata.obsm["X_pca"].shape)
print("Using PCs:", n_pcs_use)

sc.pp.neighbors(
    adata,
    n_neighbors=N_NEIGHBORS,
    n_pcs=n_pcs_use,
    use_rep="X_pca"
)

scv.pp.moments(
    adata,
    n_pcs=n_pcs_use,
    n_neighbors=N_NEIGHBORS
)

# ============================================================
# 10) RUN RNA VELOCITY
# ============================================================

if VELOCITY_MODE == "dynamical":
    scv.tl.recover_dynamics(adata)
    scv.tl.velocity(adata, mode="dynamical")
else:
    scv.tl.velocity(adata, mode="stochastic")

scv.tl.velocity_graph(adata)
scv.tl.velocity_confidence(adata)
scv.tl.velocity_pseudotime(adata)

# ============================================================
# 11) PLOT VELOCITY ON STITCHED UMAP
# ============================================================

scv.settings.figdir = OUTDIR
sc.settings.figdir = OUTDIR

color_key = CELLTYPE_COL if CELLTYPE_COL in adata.obs.columns else CONDITION_COL

sc.pl.embedding(
    adata,
    basis="umap_stitched",
    color=CONDITION_COL,
    frameon=False,
    size=20,
    show=False
)

plt = __import__("matplotlib.pyplot")
plt.savefig(os.path.join(OUTDIR, "stitched_umap_by_condition.png"), dpi=300, bbox_inches="tight")
plt.close()

scv.pl.velocity_embedding_stream(
    adata,
    basis="umap_stitched",
    color=color_key,
    legend_loc="right margin",
    density=1.0,
    smooth=0.8,
    figsize=(12, 6),
    show=False
)

plt.savefig(os.path.join(OUTDIR, "velocity_stream_stitched_umap.png"), dpi=300, bbox_inches="tight")
plt.close()

scv.pl.velocity_embedding_grid(
    adata,
    basis="umap_stitched",
    color=color_key,
    arrow_size=1.5,
    density=0.8,
    figsize=(12, 6),
    show=False
)

plt.savefig(os.path.join(OUTDIR, "velocity_grid_stitched_umap.png"), dpi=300, bbox_inches="tight")
plt.close()

# ============================================================
# 12) VELOCITY METRIC PLOTS
# ============================================================

for metric, cmap in [
    ("velocity_pseudotime", "gnuplot"),
    ("velocity_confidence", "viridis"),
    ("velocity_length", "viridis")
]:
    if metric in adata.obs.columns:
        scv.pl.scatter(
            adata,
            basis="umap_stitched",
            color=metric,
            cmap=cmap,
            figsize=(8, 5),
            show=False
        )
        plt.savefig(os.path.join(OUTDIR, f"{metric}_stitched_umap.png"), dpi=300, bbox_inches="tight")
        plt.close()

# ============================================================
# 13) VELOCITY-PAGA
# ============================================================

cluster_key = CELLTYPE_COL if CELLTYPE_COL in adata.obs.columns else "seurat_clusters"

if cluster_key not in adata.obs.columns:
    raise ValueError("No cell type or cluster column found for PAGA.")

adata.obs[cluster_key] = adata.obs[cluster_key].astype("category")

sc.tl.paga(adata, groups=cluster_key)
scv.tl.paga(adata, groups=cluster_key)

adata.uns["paga"]["pos"] = adata.obsm["X_umap_stitched"]

scv.pl.paga(
    adata,
    basis="umap_stitched",
    groups=cluster_key,
    threshold=0.15,
    min_edge_width=2,
    node_size_scale=1.2,
    arrow_size=60,
    figsize=(12, 6),
    show=False
)

plt.savefig(os.path.join(OUTDIR, "velocity_PAGA_stitched_umap.png"), dpi=300, bbox_inches="tight")
plt.close()

# Export PAGA transitions if available
if "paga" in adata.uns and "transitions_confidence" in adata.uns["paga"]:
    trans = adata.uns["paga"]["transitions_confidence"]
    labels = adata.obs[cluster_key].cat.categories

    trans_df = pd.DataFrame(
        trans.toarray() if hasattr(trans, "toarray") else trans,
        index=labels,
        columns=labels
    )

    trans_df.to_csv(os.path.join(OUTDIR, "velocity_PAGA_transitions_confidence.csv"))

# ============================================================
# 14) SAVE FINAL OBJECT
# ============================================================

adata.write_h5ad(os.path.join(OUTDIR, "stitched_velocity_scvelo_paga.h5ad"))

print("Done.")
print("Results saved in:", OUTDIR)
